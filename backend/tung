#candiate profile
SELECT
    C.*,
    D.DOCUMENT_ID,
    D.DOCUMENT_KIND,
    D.FILE_NAME,
    D.CONTENT_TYPE,
    D.FILE_SIZE,
    LENGTH(D.FILE_DATA) AS STORED_BYTES,
    D.UPLOADED_AT
FROM CANDIDATE_PROFILE C
LEFT JOIN CANDIDATE_DOCUMENT D
    ON D.CANDIDATE_ID = C.CANDIDATE_ID
ORDER BY C.EMAIL, D.UPLOADED_AT;

